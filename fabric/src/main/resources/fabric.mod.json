{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Prevent mob spawning with a beacon-like structure",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/${repository}",
    "issues": "https://github.com/${repository}/issues"
  },
  "license": "https://github.com/${repository}/LICENSE.txt",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.possible_triangle.brazier.BrazierFabric"
    ],
    "client": [
      "com.possible_triangle.brazier.BrazierFabric"
    ],
    "jei_mod_plugin": [
      "com.possible_triangle.brazier.compat.jei.JeiPlugin"
    ],
    "rei_client": [
      "com.possible_triangle.brazier.compat.rei.ReiPlugin"
    ],
    "fabric-datagen": [
      "com.possible_triangle.brazier.datagen.DateGenerators"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}-fabric.mixins.json"
  ],
  "depends": {
    "fabric-api": "*",
    "minecraft": ">=1.20.1"
  }
}
